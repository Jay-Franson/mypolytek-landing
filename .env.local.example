# Copy this file to .env.local and fill in your API keys
# DO NOT commit .env.local to GitHub (it's ignored by .gitignore)

# GoHighLevel API Token
# Get from: GoHighLevel → Settings → API → Create Private Integration
GHL_API_KEY=your_ghl_api_key_here

# BuilderPrime API Key
# Get from: BuilderPrime Admin → Integrations → Open API → API Key
BUILDERPRIME_API_KEY=your_builderprime_api_key_here
