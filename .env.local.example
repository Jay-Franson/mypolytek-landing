# Copy this file to .env.local and fill in your credentials.
# DO NOT commit .env.local to GitHub (it's ignored by .gitignore).
#
# These same variables must also be configured in Vercel:
#   Vercel Dashboard → Project → Settings → Environment Variables

# ─────────────────────────────────────────────────────────
# Google Sheets — Lead capture (REQUIRED)
# Service account JSON (entire JSON object as a single line).
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Then share the target Google Sheet with the service account email.
# ─────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ─────────────────────────────────────────────────────────
# Gmail — Email notifications (REQUIRED)
# 16-character App Password (NOT your Gmail login password).
# Generate at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: override the sending Gmail account (defaults to jay@powrful.com)
# GMAIL_USER=jay@powrful.com

# ─────────────────────────────────────────────────────────
# Hatch CRM — Contact creation (REQUIRED)
# Get from: Hatch → Settings → API → Generate Token
# ─────────────────────────────────────────────────────────
HATCH_API_KEY=your_hatch_api_key_here

# ─────────────────────────────────────────────────────────
# Cloudflare Turnstile — Bot protection (REQUIRED in production)
# Get from: Cloudflare Dashboard → Turnstile → your widget → Secret Key
# Starts with "0x4..." — keep this private (never put in client-side code).
# If not set, the server skips bot verification with a warning log
# (useful for local dev). ALWAYS set this in Vercel for production.
# ─────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
